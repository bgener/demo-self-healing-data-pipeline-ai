{
  "name": "DocumentDB to ClickHouse",
  "namespaceDefinition": "destination",
  "status": "active",
  "schedule": {
    "units": 1,
    "timeUnit": "hours"
  },
  "syncCatalog": {
    "streams": [
      {
        "stream": {
          "name": "orders",
          "namespace": "ecommerce"
        },
        "config": {
          "syncMode": "incremental",
          "destinationSyncMode": "append",
          "cursorField": ["createdAt"]
        }
      },
      {
        "stream": {
          "name": "customers",
          "namespace": "ecommerce"
        },
        "config": {
          "syncMode": "full_refresh",
          "destinationSyncMode": "overwrite"
        }
      }
    ]
  }
}
